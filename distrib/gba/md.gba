file /usr/include/sys/uio.h
file /usr/include/sys/user.h
file /usr/include/sys/utsname.h
file /usr/include/sys/vm.h
file /usr/include/sys/vmmac.h
file /usr/include/sys/vmmeter.h
file /usr/include/sys/vmparam.h
file /usr/include/sys/vmsystm.h
file /usr/include/sys/wait.h

#
# Native C toolchain, so a program can be compiled ON the device:
# cc drives cpp -> smlrc (Smaller C, arm backend) -> as (as_arm) -> ld
# (ld_arm), linking /usr/lib/crt0.o + /usr/lib/libc.a into an OMAGIC a.out.
# Arm/GBA-specific (the MIPS ports ship their own in md.pic32). Sample
# sources to compile on the device (hello.c, ctest.c) are in
# /usr/share/examples/gba, listed in mi.gba.
#
default
filemode 0755
file /usr/bin/cc
file /usr/bin/cpp
file /usr/bin/as
file /usr/bin/ld
file /usr/bin/ar
file /usr/libexec/smlrc

default
dir /usr/lib
file /usr/lib/crt0.o
file /usr/lib/libc.a

#
# The link-cable UART as a raw byte stream for SLIP (char major 20); while
# open it is taken off the serial console.  SERIAL_CONSOLE (GBAED) builds.
#
default
filemode 0600
cdev /dev/sio
major 20
minor 0

#
# Raw (character) sd disks - GBA-specific (char major 19 = SD_CMAJOR in
# sys/arch/gba/gba/conf.c; only this port has that cdevsw slot). Same minor
# encoding as the shared block sd* nodes (unit<<3 | partition). They let
# fsck reach the disk through physio()/sdstrategy(); in particular
# `fsck -n /dev/rsd0b` checks the mounted root read-only without unmounting
# (an O_RDONLY raw-disk open is allowed while the block device is mounted;
# a writable open is still refused - see chrtoblk() in conf.c). Root-only.
#
default
filemode 0600
cdev /dev/rsd0
major 19
minor 0
cdev /dev/rsd0a
major 19
minor 1
cdev /dev/rsd0b
major 19
minor 2
cdev /dev/rsd0c
major 19
minor 3
cdev /dev/rsd0d
major 19
minor 4

#
# Time zone database: ship the full compiled zoneinfo tree so any zone
# works at runtime via the TZ env var or by re-linking /etc/localtime;
# date() otherwise reads /etc/localtime (-> Japan) and the GBAED kernel's
# TIMEZONE=-540 remains the last-resort fallback. Upstream base/mi ships
# zoneinfo too, but this port builds its image from the GBA-specific base
# (distrib/gba/mi.gba), not distrib/base/mi, so it is listed here.
#
default
filemode 0644
dir /usr/share
dir /usr/share/zoneinfo
dir /usr/share/zoneinfo/Australia
dir /usr/share/zoneinfo/Canada
dir /usr/share/zoneinfo/SystemV
dir /usr/share/zoneinfo/US
file /usr/share/zoneinfo/Australia/NSW
file /usr/share/zoneinfo/Australia/North
file /usr/share/zoneinfo/Australia/Queensland
file /usr/share/zoneinfo/Australia/South
file /usr/share/zoneinfo/Australia/Tasmania
file /usr/share/zoneinfo/Australia/Victoria
file /usr/share/zoneinfo/Australia/West
file /usr/share/zoneinfo/CET
file /usr/share/zoneinfo/CST6CDT
file /usr/share/zoneinfo/Canada/Atlantic
file /usr/share/zoneinfo/Canada/Central
file /usr/share/zoneinfo/Canada/Eastern
file /usr/share/zoneinfo/Canada/Mountain
file /usr/share/zoneinfo/Canada/Newfoundland
file /usr/share/zoneinfo/Canada/Pacific
file /usr/share/zoneinfo/Canada/Yukon
file /usr/share/zoneinfo/EET
file /usr/share/zoneinfo/EST
file /usr/share/zoneinfo/EST5EDT
file /usr/share/zoneinfo/GMT
file /usr/share/zoneinfo/GMT+1
file /usr/share/zoneinfo/GMT+10
