#
# Machine dependent GBA root file system manifest file.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

#
# Directories.
#
dir /bin
dir /dev
dir /etc
dir /sbin
dir /tmp

#
# Files: /usr/include (machine-dependent headers)
#
# The GBA machine headers, so the on-device native toolchain and anything
# else building on target can find <machine/*.h>. /usr and /usr/bin come
# from the shared (mi) manifest; the machine headers are per-port, so they
# live here as on the other ports (see distrib/stm32/md.stm32,
# distrib/pic32/md.pic32).
#
# This list is the set both reference ports (pic32 AND stm32) ship - their
# agreed common headers. Headers where the two ports diverge are left out
# pending a separate decision: stm32-only fault.h/intr.h/mpuvar.h; the
# per-port hardware-register header (pic32 ships pic32mx.h, the GBA analog
# is gba.h); and the GBA-only gba_syscall.h/syscall.h/sched_test.h that
# neither reference port has.
#
default
filemode 0664
dir /usr/include
dir /usr/include/machine
file /usr/include/machine/_float.h
file /usr/include/machine/cpu.h
file /usr/include/machine/debug.h
file /usr/include/machine/elf_machdep.h
file /usr/include/machine/frame.h
file /usr/include/machine/io.h
file /usr/include/machine/limits.h
file /usr/include/machine/machparam.h
file /usr/include/machine/setjmp.h
file /usr/include/machine/signal.h
file /usr/include/machine/types.h

#
# Raw (character) sd disks - GBA-specific (char major 19 = SD_CMAJOR in
# sys/arch/gba/gba/conf.c; only this port has that cdevsw slot). Same minor
# encoding as the shared block sd* nodes (unit<<3 | partition). They let
# fsck reach the disk through physio()/sdstrategy(); in particular
# `fsck -n /dev/rsd0b` checks the mounted root read-only without unmounting
# (an O_RDONLY raw-disk open is allowed while the block device is mounted;
# a writable open is still refused - see chrtoblk() in conf.c). Root-only.
#
default
filemode 0600
cdev /dev/rsd0
major 19
minor 0
cdev /dev/rsd0a
major 19
minor 1
cdev /dev/rsd0b
major 19
minor 2
cdev /dev/rsd0c
major 19
minor 3
cdev /dev/rsd0d
major 19
minor 4

#
# Time zone database: ship the full compiled zoneinfo tree so any zone
# works at runtime via the TZ env var or by re-linking /etc/localtime;
# date() otherwise reads /etc/localtime (-> Japan) and the GBAED kernel's
# TIMEZONE=-540 remains the last-resort fallback. Upstream base/mi ships
# zoneinfo too, but this port builds its image from the GBA-specific base
# (distrib/gba/mi.gba), not distrib/base/mi, so it is listed here.
#
default
filemode 0644
dir /usr/share
dir /usr/share/zoneinfo
dir /usr/share/zoneinfo/Australia
dir /usr/share/zoneinfo/Canada
dir /usr/share/zoneinfo/SystemV
dir /usr/share/zoneinfo/US
file /usr/share/zoneinfo/Australia/NSW
file /usr/share/zoneinfo/Australia/North
file /usr/share/zoneinfo/Australia/Queensland
file /usr/share/zoneinfo/Australia/South
file /usr/share/zoneinfo/Australia/Tasmania
file /usr/share/zoneinfo/Australia/Victoria
file /usr/share/zoneinfo/Australia/West
file /usr/share/zoneinfo/CET
file /usr/share/zoneinfo/CST6CDT
file /usr/share/zoneinfo/Canada/Atlantic
file /usr/share/zoneinfo/Canada/Central
file /usr/share/zoneinfo/Canada/Eastern
file /usr/share/zoneinfo/Canada/Mountain
file /usr/share/zoneinfo/Canada/Newfoundland
file /usr/share/zoneinfo/Canada/Pacific
file /usr/share/zoneinfo/Canada/Yukon
file /usr/share/zoneinfo/EET
file /usr/share/zoneinfo/EST
file /usr/share/zoneinfo/EST5EDT
file /usr/share/zoneinfo/GMT
file /usr/share/zoneinfo/GMT+1
file /usr/share/zoneinfo/GMT+10
file /usr/share/zoneinfo/GMT+11
file /usr/share/zoneinfo/GMT+12
file /usr/share/zoneinfo/GMT+13
file /usr/share/zoneinfo/GMT+2
file /usr/share/zoneinfo/GMT+3
file /usr/share/zoneinfo/GMT+4
file /usr/share/zoneinfo/GMT+5
file /usr/share/zoneinfo/GMT+6
file /usr/share/zoneinfo/GMT+7
file /usr/share/zoneinfo/GMT+8
file /usr/share/zoneinfo/GMT+9
file /usr/share/zoneinfo/GMT-1
file /usr/share/zoneinfo/GMT-10
file /usr/share/zoneinfo/GMT-11
file /usr/share/zoneinfo/GMT-12
file /usr/share/zoneinfo/GMT-2
file /usr/share/zoneinfo/GMT-3
file /usr/share/zoneinfo/GMT-4
file /usr/share/zoneinfo/GMT-5
file /usr/share/zoneinfo/GMT-6
file /usr/share/zoneinfo/GMT-7
file /usr/share/zoneinfo/GMT-8
file /usr/share/zoneinfo/GMT-9
file /usr/share/zoneinfo/Greenwich
file /usr/share/zoneinfo/HST
file /usr/share/zoneinfo/Japan
file /usr/share/zoneinfo/MST
file /usr/share/zoneinfo/MST7MDT
file /usr/share/zoneinfo/NZ
file /usr/share/zoneinfo/PST8PDT
file /usr/share/zoneinfo/Singapore
file /usr/share/zoneinfo/SystemV/AST4
file /usr/share/zoneinfo/SystemV/AST4ADT
file /usr/share/zoneinfo/SystemV/CST6
file /usr/share/zoneinfo/SystemV/CST6CDT
file /usr/share/zoneinfo/SystemV/EST5
file /usr/share/zoneinfo/SystemV/EST5EDT
file /usr/share/zoneinfo/SystemV/HST10
file /usr/share/zoneinfo/SystemV/MST7
file /usr/share/zoneinfo/SystemV/MST7MDT
file /usr/share/zoneinfo/SystemV/PST8
file /usr/share/zoneinfo/SystemV/PST8PDT
file /usr/share/zoneinfo/SystemV/YST9
file /usr/share/zoneinfo/SystemV/YST9YDT
file /usr/share/zoneinfo/Turkey
file /usr/share/zoneinfo/UCT
file /usr/share/zoneinfo/US/Arizona
file /usr/share/zoneinfo/US/Central
file /usr/share/zoneinfo/US/East-Indiana
file /usr/share/zoneinfo/US/Eastern
file /usr/share/zoneinfo/US/Hawaii
file /usr/share/zoneinfo/US/Mountain
file /usr/share/zoneinfo/US/Pacific
file /usr/share/zoneinfo/US/Pacific-New
file /usr/share/zoneinfo/US/Yukon
file /usr/share/zoneinfo/UTC
file /usr/share/zoneinfo/Universal
file /usr/share/zoneinfo/W-SU
file /usr/share/zoneinfo/WET
symlink /etc/localtime
target /usr/share/zoneinfo/Japan
