#
# Machine dependent GBA root file system manifest file.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

#
# Directories.
#
dir /bin
dir /dev
dir /etc
dir /sbin
dir /tmp

#
# Files: /usr/include (machine-dependent headers)
#
# The GBA machine headers, so the on-device native toolchain and anything
# else building on target can find <machine/*.h>. /usr and /usr/bin come
# from the shared (mi) manifest; the machine headers are per-port, so they
# live here as on the other ports (see distrib/stm32/md.stm32,
# distrib/pic32/md.pic32).
#
# This list is the set both reference ports (pic32 AND stm32) ship - their
# agreed common headers. Headers where the two ports diverge are left out
# pending a separate decision: intr.h and mpuvar.h (stm32 has them, pic32
# does not); the per-port hardware-register header (pic32 ships pic32mx.h,
# the GBA analog is gba.h); and the GBA-only gba_syscall.h that neither
# reference port has.
#
default
filemode 0664
dir /usr/include
dir /usr/include/machine
file /usr/include/machine/_float.h
file /usr/include/machine/cpu.h
file /usr/include/machine/debug.h
file /usr/include/machine/elf_machdep.h
file /usr/include/machine/frame.h
file /usr/include/machine/io.h
file /usr/include/machine/limits.h
file /usr/include/machine/machparam.h
file /usr/include/machine/setjmp.h
file /usr/include/machine/signal.h
file /usr/include/machine/types.h

#
# Standard C headers, so on-device programs can #include them (machine/*
# headers are listed above). Functions absent from the minimal on-device
# libc still link-fail cleanly; these just let normal C compile on target.
#
default
filemode 0644
file /usr/include/alloca.h
file /usr/include/a.out.h
file /usr/include/ar.h
file /usr/include/assert.h
file /usr/include/ctype.h
file /usr/include/curses.h
file /usr/include/errno.h
file /usr/include/fcntl.h
file /usr/include/float.h
file /usr/include/fstab.h
file /usr/include/grp.h
file /usr/include/kmem.h
file /usr/include/lastlog.h
file /usr/include/libgen.h
file /usr/include/limits.h
file /usr/include/math.h
file /usr/include/mtab.h
file /usr/include/ndbm.h
file /usr/include/nlist.h
file /usr/include/paths.h
file /usr/include/psout.h
file /usr/include/pwd.h
file /usr/include/ranlib.h
file /usr/include/regexp.h
file /usr/include/setjmp.h
file /usr/include/sgtty.h
file /usr/include/signal.h
file /usr/include/stdarg.h
file /usr/include/stdbool.h
file /usr/include/stddef.h
file /usr/include/stdint.h
file /usr/include/stdio.h
file /usr/include/stdlib.h
file /usr/include/string.h
file /usr/include/strings.h
file /usr/include/struct.h
file /usr/include/syscall.h
file /usr/include/sysexits.h
file /usr/include/syslog.h
file /usr/include/term.h
file /usr/include/time.h
file /usr/include/ttyent.h
