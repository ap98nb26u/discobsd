#
# Machine dependent PIC32 root file system manifest file.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

#
# Directories.
#
dir /bin
dir /dev
dir /etc
dir /sbin
dir /tmp
dir /usr
dir /home

#
# Files: /usr/bin
#
default
filemode 0775
dir /usr/bin
file /usr/bin/adb
# XXX file /usr/bin/adc-demo

#
# Self-hosting C toolchain (compiler/assembler/linker/binutils/build
# tools) - moved here from the shared mi manifest since it's PIC32/MIPS32
# specific: usr.bin/as/as.c and usr.bin/ld/ld.c are both hardcoded
# "for MIPS32 architecture" (real opcodes, no other target), and cc.c
# is built around that same as/ld pair (#ifdef __mips__). None of it can
# produce working code for an ARM target like GBA or stm32, and GBA in
# particular has nowhere near enough IWRAM/EWRAM to self-host a compiler
# anyway. The rest of this cluster (make/yacc/m4/binutils/alternate
# compiler variants) exists to support the same on-device development
# workflow, which only pic32 boards are set up for (see /usr/bin/adb and
# /usr/libexec/smlrc above/below).
file /usr/bin/ar
file /usr/bin/as
file /usr/bin/cb
file /usr/bin/cc
file /usr/bin/cpp
file /usr/bin/lcc
file /usr/bin/lcpp
file /usr/bin/ld
file /usr/bin/m4
file /usr/bin/make
file /usr/bin/nm
file /usr/bin/pdc
file /usr/bin/ranlib
file /usr/bin/size
file /usr/bin/strip
file /usr/bin/yacc

#
# Files: /usr/include
#
default
filemode 0664
dir /usr/include
dir /usr/include/machine
file /usr/include/machine/_float.h
file /usr/include/machine/cpu.h
file /usr/include/machine/debug.h
file /usr/include/machine/elf_machdep.h
file /usr/include/machine/frame.h
file /usr/include/machine/io.h
file /usr/include/machine/limits.h
file /usr/include/machine/machparam.h
file /usr/include/machine/pic32mx.h
file /usr/include/machine/setjmp.h
file /usr/include/machine/signal.h
file /usr/include/machine/types.h

#
# Files: /usr/libexec
#
default
filemode 0775
dir /usr/libexec
file /usr/libexec/smlrc

#
# Files: /usr/share/man
#
default
dirmode 0775
dir /usr/share/man
dir /usr/share/man/cat1

#
# Single pages
#
file /usr/share/man/cat1/adb.0
