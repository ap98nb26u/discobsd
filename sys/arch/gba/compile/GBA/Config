#
# GameBoy Advance (GBA)
# =====================================
#
# To build the kernel, use:
#   cd sys/arch/gba/compile/GBA
#   tools/bin/config Config
#   make clean
#   make
#
architecture    "gba"
cpu             "ARM7TDMI"                  # Processor variant
board           "GBA"                       # Board type
#ldscript        "GBA.ld"                    # Kernel memory linker script
ldscript        "kern.ldscript"             # Kernel memory linker script

makeoptions     DEBUG="-g"                  # Debug symbols

# Standard system options
options         "CPU_KHZ=16777"             # Oscillator frequency of CPU core
options         "BUS_KHZ=16777"             # Frequency of peripheral bus
options         "HALTREBOOT"                # If halted, press key to reboot

#options        "GLOBAL_DEBUG"              # Enable debugging
options         "DIAGNOSTIC"                # Enable diagnostics

device           mr0                        # read-only Memory disk in ROM

# Root filesystem at /dev/mr0a, swap at /dev/mr0b
config          unix    root on mr0a
                        swap on mr0b

# Serial UART ports
device          uart1                       # USART1 as console
device          uart2                       # USART2
options         "UART_BAUD=115200"          # default speed

# Use USART1 on debug header as serial console
options         "CONS_MAJOR=UART_MAJOR"     # UART device
options         "CONS_MINOR=0"              # uart1 is /dev/tty0

# Standalone-demo build: the console is the LCD text screen driven by
# the on-screen software keyboard, with NO serial cable attached. The
# SIO/UART link-cable console (gsio_*) hardware-flow-controls on CTS
# and a per-byte send-complete flag that never complete with nothing
# wired to the cable -- costing ~0.5s per character on real hardware
# and still mirroring output to a serial peer when one IS attached.
# Compile the serial path out entirely for this config so the LCD
# console runs at full speed cable-free; the GBAED config keeps serial
# for interactive debugging over a cable.
options         "NO_SERIAL_CONSOLE"         # LCD-only console, no gsio

# SDIO port
#controller      sdio0                       # SDIO port
#options         "SDIO_XFER_CLK_DIV=2"       # APB2 84MHz / (DIV + 2) < 25MHz

# MicroSD card on underside of board
#evice          sd0     at sdio0            # SD card uses SDIO port
#ptions         "NSD=1"                     # One disk on SDIO.
