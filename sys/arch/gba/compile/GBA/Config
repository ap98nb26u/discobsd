#
# GameBoy Advance (GBA)
# =====================================
#
# To build the kernel, use:
#   cd sys/arch/gba/compile/GBA
#   tools/bin/config Config
#   make clean
#   make
#
architecture    "gba"
cpu             "ARM7TDMI"                  # Processor variant
board           "GBA"                       # Board type
ldscript        "kern_gba.ldscript"             # Kernel memory linker script

makeoptions     DEBUG="-g"                  # Debug symbols

# Standard system options
options         "CPU_KHZ=16777"             # Oscillator frequency of CPU core
options         "BUS_KHZ=16777"             # Frequency of peripheral bus
options         "HALTREBOOT"                # If halted, press key to reboot

# On-screen console screen-saver: blank the LCD after this many idle
# seconds (no console input or output), restore on any activity. Blanking
# just disables BG2 so a black backdrop shows -- VRAM is kept, so the text
# returns intact; no BIOS SWI is used, so it behaves the same on real
# hardware and under mGBA. 0 disables it. Tunable at runtime via the
# machdep.console_blank sysctl.
options         "SCREEN_BLANK_SECS=60"      # blank LCD after 60s idle
options         "TTYEDIT"                   # cooked-mode command-line editing (cursor/insert/delete)
options         "TTYEDIT_HISTORY=4"         # command-history lines (up/down)

#options        "GLOBAL_DEBUG"              # Enable debugging
options         "DIAGNOSTIC"                # Enable diagnostics
options         "HANGDUMP"                  # L+R+SELECT: print where the kernel is (hang debugging)

# Memory disk (dev/md.c): the root filesystem image linked into the ROM
# (md0a: read-only, or writable where the "ROM" is RAM - an EverDrive) and
# swap in EWRAM (md0b; in the PSRAM after the root when that root is
# writable); md_gba.c adds the GBA hooks.
device          md0
options         "MD_MACHDEP"                # GBA hooks, arch/gba/dev/md_gba.c
options         "MD_ROOTIMAGE"              # link the root image (make fs) for md0a
options         "MD_ROOT_RW"                # md0a writable when it is RAM (EverDrive PSRAM)

# Root filesystem at /dev/md0a, swap at /dev/md0b
config          unix    root on md0a
                        swap on md0b

# Serial port: the link port's SIO in UART mode (dev/gba_sio_uart.c,
# dev/mgba_uart.c) - the GBA has just this one.
device          uart1                       # SIO UART, the console tty
options         "UART_BAUD=115200"          # default speed

# Console. Output always goes to the on-screen LCD text console (gtxt),
# and input always comes from the on-screen software keyboard (swkbd);
# those are unconditional. SERIAL_CONSOLE also mirrors output to, and takes
# input from, the SIO/UART link-cable console (gsio), so a GBA with a serial
# cable can be used from a terminal and run slipd. With no cable nothing
# drains the send FIFO: gsio_putc() waits once, then drops serial until a
# byte arrives, so a cable-free GBA keeps a full-speed LCD console.
# This is the plain GBA kernel: no emulator log is compiled in, so it
# runs on real hardware with or without an EverDrive. For a headless
# emulator console log (mGBA / VisualBoyAdvance) use the GBALOG config,
# which is this config plus options "AGBPRINT".
options         "CONS_MAJOR=UART_MAJOR"     # console is the uart tty
options         "CONS_MINOR=0"              # uart1 is /dev/tty0
options         "SERIAL_CONSOLE"            # UART console over the link cable

# Pseudo-terminals, for telnet logins through slipd (usr.sbin/slipd).
# Those need the EverDrive's PSRAM swap: on a plain flash cartridge the
# 185K of EWRAM swap is too small for slipd and a login shell.
# Their tty structures live in the last 1K of EWRAM (KEWRAM in
# kern_gba.ldscript) - IWRAM has no room left.
service         pty     2
