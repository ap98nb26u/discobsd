#
# GameBoy Advance (GBA)
# =====================================
#
# To build the kernel, use:
#   cd sys/arch/gba/compile/GBA
#   tools/bin/config Config
#   make clean
#   make
#
architecture    "gba"
cpu             "ARM7TDMI"                  # Processor variant
board           "GBA"                       # Board type
options         "GBAED"                     # real EverDrive SD build (vs plain GBA/mrams); selects the large-USERRAM layout & real-SD paths
ldscript        "kern_gbaed.ldscript"             # Kernel memory linker script

makeoptions     DEBUG="-g"                  # Debug symbols

# Standard system options
options         "CPU_KHZ=16777"             # Oscillator frequency of CPU core
options         "BUS_KHZ=16777"             # Frequency of peripheral bus
options         "HALTREBOOT"                # If halted, press key to reboot

# On-screen console screen-saver: blank the LCD after this many idle
# seconds (no console input or output), restore on any activity. Blanking
# just disables BG2 so a black backdrop shows -- VRAM is kept, so the text
# returns intact; no BIOS SWI is used, so it behaves the same on real
# hardware and under mGBA. 0 disables it. Tunable at runtime via the
# machdep.console_blank sysctl.
options         "SCREEN_BLANK_SECS=60"      # blank LCD after 60s idle
options         "TTYEDIT"                   # cooked-mode command-line editing (cursor/insert/delete)
options         "TTYEDIT_HISTORY=8"         # command-history lines (up/down)

#options        "GLOBAL_DEBUG"              # Enable debugging
options         "DIAGNOSTIC"                # Enable diagnostics

# Real-time clock / timezone.
#
# This project is developed in Japan, so this build defaults to JST.
# Two INDEPENDENT settings are involved:
#
#   RTC_OFFSET - minutes WEST of UTC that the EverDrive's RTC hardware
#                is actually set to. This board's RTC keeps local JST
#                wall-clock time, which is 9 hours EAST of UTC, i.e.
#                -540 minutes west. inittodr() uses this to convert the
#                RTC reading to the UTC the kernel clock runs on. If YOUR
#                RTC keeps UTC (the traditional UNIX convention), set 0;
#                if it keeps some other local time, set that zone's
#                minutes-west. Also reachable at runtime as the
#                kern.rtc_offset sysctl.
#
#   TIMEZONE   - minutes west of UTC for the DEFAULT display timezone
#                (what date(1) shows when $TZ is unset). -540 = JST.
#                Purely cosmetic; does not affect the stored UTC clock.
options         "RTC_OFFSET=-540"           # EverDrive RTC keeps JST local time
options         "TIMEZONE=-540"             # default display zone: JST
options         "DST=0"                     # JST has no daylight saving

# sd0a is the 1st MBR partition, which on real hardware is the
# EverDrive's own FAT32 boot/menu partition, not DiscoBSD's -- see
# sd.c's sd_setup(). DiscoBSD's own partitions come after it:
# root filesystem at /dev/sd0b (2nd MBR partition), swap at /dev/sd0c
# (3rd MBR partition).
config          unix    root on sd0b
                        swap on sd0c

# Serial UART ports
device          uart1                       # USART1 as console
device          uart2                       # USART2
options         "UART_BAUD=115200"          # default speed

# Console. Output goes to the on-screen LCD console (gtxt) and input
# comes from the on-screen software keyboard (swkbd), same as the GBA
# build. This real-hardware build ADDITIONALLY enables SERIAL_CONSOLE:
# the SIO/UART link-cable console (gsio) mirrors output and takes input
# over a serial cable, for interactive debugging on real hardware. (No
# emulator console log is compiled in - that lives in the GBALOG config.)
options         "CONS_MAJOR=UART_MAJOR"     # console is the uart tty
options         "CONS_MINOR=0"              # uart1 is /dev/tty0
options         "SERIAL_CONSOLE"            # real UART console over the cable

# EverDrive GBA X5 expansion unit (SD, RTC, ... hang off this)
controller      ed0                         # EverDrive cartridge registers

# SD card, accessed through the EverDrive's own SD command port (ed0),
# not a real SDIO peripheral -- GBA has none.
device          sd0     at ed0
options         "NSD=1"                     # One SD slot on the EverDrive.

# Real-time clock, reached through the EverDrive's GPIO RTC routing.
device          rtc0    at ed0
