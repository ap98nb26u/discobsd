/*
 * Kernel linker script for the GBAED (real EverDrive SD) build.
 *
 * This build reads its root filesystem from the real SD card at runtime
 * (dev/ed.c + dev/sd.c): root on /dev/sd0b (2nd MBR partition). Swap is the
 * md memory disk's md0b, in EverDrive PSRAM (PSRAM_SWAP below). It links no
 * root image (no options MD_ROOTIMAGE), so .fs is empty and md0a has size 0.
 *
 * The plain GBA (ROM-root / mGBA) build uses kern_gba.ldscript, which embeds
 * the real bare root filesystem in .fs. Keep the two scripts in sync by hand
 * except where they deliberately diverge: GBAED has no EWRAM swap region
 * (that is ROM-root build only) and gives that space to USERRAM instead.
 */

MEMORY {
    FLASH   (rx)   : ORIGIN = 0x08000000, LENGTH = 32M   /* 0x0800 0000 - 0x09FF FFFF */

    IWRAM   (rwx)  : ORIGIN = 0x03000000, LENGTH = 32K   /* 0x0300 0000 - 0x0300 7FFF */
    SYSVEC  (rw!x) : ORIGIN = 0x03007E00, LENGTH = 4     /* 0x0300 7E00 - 0x0300 7E03: syscall trampoline vector, high in IWRAM just under the BIOS IRQ stack (must match machparam.h SYSCALL_VECTOR_ADDR) */

    EWRAM   (rwx)  : ORIGIN = 0x02000000, LENGTH = 256K  /* 0x0200 0000 - 0x0203 FFFF */
    /*
     * U0AREA/UAREA used to live in IWRAM, right up against IWRAM's very
     * end (with a 4-byte shift to dodge the GBA BIOS's fixed user-IRQ-
     * handler-pointer word at 0x03007FFC-0x03007FFF - every u/u0 context
     * switch swaps the *entire* USIZE-byte contents of u and u0, see
     * resume()/longjmp() in locore.S, so anything living right past
     * UAREA's end got clobbered by whatever garbage sat at the matching
     * offset in u0). That put two whole USIZE-byte process contexts -
     * including every process's kernel-mode C stack, since this port has
     * no separate always-resident kernel stack - into the last 6K of a
     * 32K IWRAM already packed with .data/.bss/.fast_text right up to
     * SYSVEC. A long-sleeping process's saved stack frame (proc 0's,
     * blocked in tsleep() since early boot) was found corrupted when
     * finally resumed after another process had been actively running
     * for a while - root cause not fully nailed down, but GBA's IWRAM is
     * far smaller than pic32/stm32 (which use this same two-slot u/u0
     * design without incident), making any layout collision here far
     * more likely. Moved both slots to EWRAM - not touching a fixed BIOS
     * vector to worry about here - which also frees the 6K they occupied
     * back to IWRAM for other use. Cost: process kernel-mode execution
     * (every syscall body, and hardclock()/softclock() work done while
     * "running as" a process) now stacks through EWRAM, which is slower
     * than IWRAM to access - a correctness-over-speed tradeoff.
     */
    U0AREA  (rw!x) : ORIGIN = 0x02000000, LENGTH = 3K    /* 0x0200 0000 - 0x0200 0BFF */
    UAREA   (rw!x) : ORIGIN = 0x02000C00, LENGTH = 3K    /* 0x0200 0C00 - 0x0200 17FF */
    /*
     * USERRAM is the user process's own addressable data+stack window
     * (see kern_gba.ldscript for the history of its size).
     *
     * GBAED LARGE-CAPACITY LAYOUT: unlike the plain GBA/ROM-root build, GBAED's
     * swap lives in EverDrive PSRAM (PSRAM_SWAP below), so the EWRAM SWAP staging
     * region that the ROM-root build needs is dead weight here. Reclaim
     * it: USERRAM fills ALL of EWRAM after the u/u0 area but the last 1K
     * (0x02001800..0x0203FC00 = 249K, vs the ROM-root build's 64K), so a
     * single resident process can be up to 249K and far more can be
     * parked in PSRAM swap. kern_gba.ldscript keeps the 64K USERRAM +
     * 186K EWRAM SWAP split. Keep LENGTH here in sync with
     * machparam.h's -DGBAED USER_DATA_SIZE and MAXMEM (all 249K) by hand.
     *
     * The last 1K of EWRAM (KEWRAM) is kernel .bss that IWRAM has no room
     * for: the pseudo-terminals (tty_pty.o, for telnet logins through
     * slipd).  USERRAM was 250K before that.
     */
    USERRAM (rw!x) : ORIGIN = 0x02001800, LENGTH = 249K  /* 0x0200 1800 - 0x0203 FC00 */
    KEWRAM  (rw!x) : ORIGIN = 0x0203FC00, LENGTH = 1K    /* 0x0203 FC00 - 0x0204 0000 (to EWRAM end) */
}

__kernel_flash_start	= ORIGIN(FLASH);
__kernel_flash_end	= ORIGIN(FLASH) + LENGTH(FLASH);
__kernel_data_start	= ORIGIN(EWRAM);
__kernel_data_end	= ORIGIN(USERRAM);
__iwram_start		= ORIGIN(IWRAM);
__iwram_end		= ORIGIN(IWRAM) + LENGTH(IWRAM);
__kewram_start		= ORIGIN(KEWRAM);
__kewram_end		= ORIGIN(KEWRAM) + LENGTH(KEWRAM);
__user_data_start	= ORIGIN(USERRAM);
__user_data_end		= ORIGIN(USERRAM) + LENGTH(USERRAM);
/*
 * GBAED swap lives in EverDrive PSRAM - the otherwise-unused ROM/cart
 * window above the kernel image - NOT on the SD card. The window is
 * writable at runtime because ed_probe() leaves the EverDrive in
 * NROM_RAM | ROM_WE_ON (dev/ed.c), and the CPU can store to it directly
 * (verified on real hardware). Contents are volatile (lost on power-off),
 * which is exactly what swap needs. md.c serves this range as the swap
 * block device (md0b); machparam.h/MAXMEM are unaffected (swap size is
 * independent of the user RAM window).
 *
 * To resize, change PSRAM_SWAP_SIZE/START. The region must stay clear of
 * the kernel image at ORIGIN(FLASH) (about 110 KB; the 1 MB start offset
 * leaves ample margin) and inside the first 16MB of cartridge space: with
 * the configuration ed.c's probe writes (registers on, PSRAM write-enabled)
 * the EverDrive shows only its first 16MB of PSRAM, and 0x09000000 up
 * mirrors 0x08000000 up - swap there would overwrite the kernel (seen on
 * real hardware; see md_gba.c).  So 15 MB at 0x08100000 .. 0x09000000.
 * This backs the "big swap, EWRAM stays the exec window" model - many
 * processes (each parked at its real size) rather than one giant process;
 * enough for e.g. a native Smaller C self-host pipeline whose stages each
 * fit the 249 KB EWRAM window and park here between runs.
 */
PSRAM_SWAP_SIZE		= 15M;
PSRAM_SWAP_START	= ORIGIN(FLASH) + 1M;	/* 0x08100000 .. 0x09000000 */
__swap_start		= PSRAM_SWAP_START;
__swap_end		= PSRAM_SWAP_START + PSRAM_SWAP_SIZE;

syscall_vector		= ORIGIN(SYSVEC);
u0			= ORIGIN(U0AREA);
u			= ORIGIN(UAREA);
u_end			= ORIGIN(UAREA) + LENGTH(UAREA);
_estack			= u_end;

ENTRY(_start)

SECTIONS {
    .text : {
        *(.text*)
        *(.rodata*)
        . = ALIGN(4);
    } > FLASH

    .fast_text : ALIGN(4) {
        __fast_start = .;
        *(.iwram_text)
        *longjmp.o(.text)
        *setjmp.o(.text)
        . = ALIGN(4);
        __fast_end = .;
    } > IWRAM AT > FLASH

    _sifast = LOADADDR(.fast_text);

    __etext = .;
    _rom_end = ALIGN(4);

    .fs : ALIGN(1024) {
        /*
         * Empty on GBAED (root is on the SD card; no MD_ROOTIMAGE): md0a is
         * then 0 bytes.  Kept for layout parity with kern_gba.ldscript.
         */
        __fs_start = .;
        *(.fs_image)
        . = ALIGN(4);
        __fs_end = .;
    } > FLASH

    .data : {
        __data_start__ = .;
        _sdata = .;
        *(.data*)
        . = ALIGN(4);
        __data_end__ = .;
        _edata = .;
    } > IWRAM AT > FLASH

    _sidata = LOADADDR(.data);

    /*
     * Kernel .bss kept out of IWRAM (see KEWRAM above); listed before .bss
     * so these input sections land here.  locore0.S zeroes it at boot.
     */
    .ewram_bss (NOLOAD) : {
        __ewram_bss_start = .;
        *tty_pty.o(.bss .bss.* COMMON)
        . = ALIGN(4);
        __ewram_bss_end = .;
    } > KEWRAM

    .bss : {
        __bss_start__ = .;
        _sbss = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
        _ebss = .;
    } > IWRAM

    /*
     * Empty; the IWRAM bound is enforced by the top-level ASSERT below.
     * .data/.bss/.fast_text must not grow past SYSVEC, which sits high in
     * IWRAM (0x03007E00, just below the BIOS-convention IRQ stack at
     * 0x03007F00..0x03007FA0), so kernel .data/.bss may fill IWRAM right
     * up to it. The SYS/USR kernel stack lives in EWRAM (locore0.S), so
     * nothing but the small IRQ stack is above SYSVEC.
     */
    .stack_check : {
        . = ALIGN(4);
    } > IWRAM
}

/*
 * Catch kernel IWRAM (.fast_text/.data/.bss) growing past SYSVEC into the BIOS
 * IRQ stack.  This is a TOP-LEVEL assert on a defined symbol: an ASSERT placed
 * inside an output section that emits no bytes is silently dropped by ld (that
 * hole once let a .bss overrun slip through and corrupt the IRQ stack), whereas
 * a top-level one always fires.
 */
ASSERT(__bss_end__ <= ORIGIN(SYSVEC),
    "Error: kernel IWRAM overflowed past SYSVEC into the IRQ stack!")

/* The EverDrive's write-enabled PSRAM window: see PSRAM_SWAP_SIZE. */
ASSERT(__swap_end <= 0x09000000, "PSRAM swap must end within the first 16MB")
