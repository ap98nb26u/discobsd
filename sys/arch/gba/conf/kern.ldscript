/*
 * Kernel common linker script for GBA.
 */

MEMORY {
    FLASH   (rx)   : ORIGIN = 0x08000000, LENGTH = 32M   /* 0x0800 0000 - 0x09FF FFFF */

    IWRAM   (rwx)  : ORIGIN = 0x03000000, LENGTH = 32K   /* 0x0300 0000 - 0x0300 7FFF */
    SYSVEC  (rw!x) : ORIGIN = 0x03006400, LENGTH = 4     /* 0x0300 6400 - 0x0300 6403: syscall trampoline vector */
    /*
     * U0AREA/UAREA shifted down 4 bytes from IWRAM's very end: the GBA
     * BIOS reads the user IRQ handler pointer from a fixed hardware
     * location, 0x03007FFC-0x03007FFF (the last word of IWRAM). UAREA
     * used to run right up to 0x03008000, so every u/u0 context switch
     * (which swaps the *entire* USIZE-byte contents of u and u0, see
     * resume()/longjmp() in locore.S) clobbered that word with whatever
     * garbage sat at the matching offset in u0, silently corrupting the
     * interrupt vector on every process switch after the first one.
     */
    U0AREA  (rw!x) : ORIGIN = 0x030067FC, LENGTH = 3K    /* 0x0300 67FC - 0x0300 73FB */
    UAREA   (rw!x) : ORIGIN = 0x030073FC, LENGTH = 3K    /* 0x0300 73FC - 0x0300 7FFB */

    EWRAM   (rwx)  : ORIGIN = 0x02000000, LENGTH = 256K  /* 0x0200 0000 - 0x0203 FFFF */
    USERRAM (rw!x) : ORIGIN = 0x02027000, LENGTH = 96K   /* 0x0202 7000 - 0x0203 EFFF */
    SWAP    (rw!x) : ORIGIN = 0x0203F000, LENGTH = 64K   /* 0x0203 F000 - 0x0204 EFFF */
}

__kernel_flash_start	= ORIGIN(FLASH);
__kernel_flash_end	= ORIGIN(FLASH) + LENGTH(FLASH);
__kernel_data_start	= ORIGIN(EWRAM);
__kernel_data_end	= ORIGIN(USERRAM);
__user_data_start	= ORIGIN(USERRAM);
__user_data_end		= ORIGIN(USERRAM) + LENGTH(USERRAM) - LENGTH(SWAP);
__swap_start		= ORIGIN(SWAP);
__swap_end		= ORIGIN(SWAP) + LENGTH(SWAP);

syscall_vector		= ORIGIN(SYSVEC);
u0			= ORIGIN(U0AREA);
u			= ORIGIN(UAREA);
u_end			= ORIGIN(EWRAM) + LENGTH(UAREA);
_estack			= u_end;

ENTRY(_start)

SECTIONS {
    .text : {
        *(.text*)
        *(.rodata*)
        . = ALIGN(4);
    } > FLASH

    .fast_text : ALIGN(4) {
        __fast_start = .;
        *(.iwram_text)
        *longjmp.o(.text)
        *setjmp.o(.text)
        . = ALIGN(4);
        __fast_end = .;
    } > IWRAM AT > FLASH

    _sifast = LOADADDR(.fast_text);

    __etext = .;
    _rom_end = ALIGN(4);

    .fs : ALIGN(1024) {
        __fs_start = . + 0x400; /* 1024 byte header */
        *(.fs_image)
        . = ALIGN(4);
        __fs_end = .;
    } > FLASH

    .data : {
        __data_start__ = .;
        _sdata = .;
        *(.data*)
        . = ALIGN(4);
        __data_end__ = .;
        _edata = .;
    } > IWRAM AT > FLASH

    _sidata = LOADADDR(.data);

    .bss : {
        __bss_start__ = .;
        _sbss = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
        _ebss = .;
    } > IWRAM

    /* dummy section to check free space of IWRAM */
    .stack_check : {
        . = ALIGN(4);
        ASSERT(. < (ORIGIN(IWRAM) + 25K), "Error: IWRAM overflowed into U0 area!");
    } > IWRAM
}
