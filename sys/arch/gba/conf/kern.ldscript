/*
 * Kernel common linker script for GBA.
 */

MEMORY {
    FLASH   (rx)   : ORIGIN = 0x08000000, LENGTH = 32M   /* 0x0800 0000 - 0x09FF FFFF */

    IWRAM   (rwx)  : ORIGIN = 0x03000000, LENGTH = 32K   /* 0x0300 0000 - 0x0300 7FFF */
    SYSVEC  (rw!x) : ORIGIN = 0x03006400, LENGTH = 4     /* 0x0300 6400 - 0x0300 6403: syscall trampoline vector */

    EWRAM   (rwx)  : ORIGIN = 0x02000000, LENGTH = 256K  /* 0x0200 0000 - 0x0203 FFFF */
    /*
     * U0AREA/UAREA used to live in IWRAM, right up against IWRAM's very
     * end (with a 4-byte shift to dodge the GBA BIOS's fixed user-IRQ-
     * handler-pointer word at 0x03007FFC-0x03007FFF - every u/u0 context
     * switch swaps the *entire* USIZE-byte contents of u and u0, see
     * resume()/longjmp() in locore.S, so anything living right past
     * UAREA's end got clobbered by whatever garbage sat at the matching
     * offset in u0). That put two whole USIZE-byte process contexts -
     * including every process's kernel-mode C stack, since this port has
     * no separate always-resident kernel stack - into the last 6K of a
     * 32K IWRAM already packed with .data/.bss/.fast_text right up to
     * SYSVEC. A long-sleeping process's saved stack frame (proc 0's,
     * blocked in tsleep() since early boot) was found corrupted when
     * finally resumed after another process had been actively running
     * for a while - root cause not fully nailed down, but GBA's IWRAM is
     * far smaller than pic32/stm32 (which use this same two-slot u/u0
     * design without incident), making any layout collision here far
     * more likely. Moved both slots to EWRAM - not touching a fixed BIOS
     * vector to worry about here - which also frees the 6K they occupied
     * back to IWRAM for other use. Cost: process kernel-mode execution
     * (every syscall body, and hardclock()/softclock() work done while
     * "running as" a process) now stacks through EWRAM, which is slower
     * than IWRAM to access - a correctness-over-speed tradeoff while this
     * port is still getting to a stable interactive shell.
     */
    U0AREA  (rw!x) : ORIGIN = 0x02000000, LENGTH = 3K    /* 0x0200 0000 - 0x0200 0BFF */
    UAREA   (rw!x) : ORIGIN = 0x02000C00, LENGTH = 3K    /* 0x0200 0C00 - 0x0200 17FF */
    /*
     * USERRAM is just the user process's own addressable data+stack
     * window (32K - big enough for a single process like /sbin/init,
     * ~30K observed); SWAP is mrams.c's (GBA/mGBA-only) swap staging
     * area, a *real* EWRAM range that mrams_write()/mrams_read() copy
     * to/from directly (see __swap_start/__swap_end there) - it is NOT
     * a disk partition on this config, unlike GBAED's real sd.c.
     *
     * These two used to be declared as one 96K USERRAM block with SWAP
     * carved out of its LENGTH via subtraction, but SWAP's ORIGIN was
     * computed from the *wrong* end of that block (ORIGIN(USERRAM) +
     * LENGTH(USERRAM), not the actual end of the live user window) -
     * SWAP's declared end (0x0204F000) overshot EWRAM's real 256K
     * boundary (0x02040000) by 60K. GBA's EWRAM bus wraps every 256K,
     * so writes into that overshoot silently aliased back into the
     * kernel's own static data at the *start* of EWRAM (0x02000000+),
     * corrupting it - this went unnoticed until swap was actually
     * exercised by a second process for the first time. Now declared
     * as two separate, contiguous, non-overlapping blocks that together
     * exactly fill the rest of real EWRAM after the user window.
     */
    USERRAM (rw!x) : ORIGIN = 0x02027000, LENGTH = 32K   /* 0x0202 7000 - 0x0202 EFFF */
    SWAP    (rw!x) : ORIGIN = 0x0202F000, LENGTH = 68K   /* 0x0202 F000 - 0x0203 FFFF */
}

__kernel_flash_start	= ORIGIN(FLASH);
__kernel_flash_end	= ORIGIN(FLASH) + LENGTH(FLASH);
__kernel_data_start	= ORIGIN(EWRAM);
__kernel_data_end	= ORIGIN(USERRAM);
__user_data_start	= ORIGIN(USERRAM);
__user_data_end		= ORIGIN(USERRAM) + LENGTH(USERRAM);
__swap_start		= ORIGIN(SWAP);
__swap_end		= ORIGIN(SWAP) + LENGTH(SWAP);

syscall_vector		= ORIGIN(SYSVEC);
u0			= ORIGIN(U0AREA);
u			= ORIGIN(UAREA);
u_end			= ORIGIN(UAREA) + LENGTH(UAREA);
_estack			= u_end;

ENTRY(_start)

SECTIONS {
    .text : {
        *(.text*)
        *(.rodata*)
        . = ALIGN(4);
    } > FLASH

    .fast_text : ALIGN(4) {
        __fast_start = .;
        *(.iwram_text)
        *longjmp.o(.text)
        *setjmp.o(.text)
        . = ALIGN(4);
        __fast_end = .;
    } > IWRAM AT > FLASH

    _sifast = LOADADDR(.fast_text);

    __etext = .;
    _rom_end = ALIGN(4);

    .fs : ALIGN(1024) {
        __fs_start = . + 0x400; /* 1024 byte header */
        *(.fs_image)
        . = ALIGN(4);
        __fs_end = .;
    } > FLASH

    .data : {
        __data_start__ = .;
        _sdata = .;
        *(.data*)
        . = ALIGN(4);
        __data_end__ = .;
        _edata = .;
    } > IWRAM AT > FLASH

    _sidata = LOADADDR(.data);

    .bss : {
        __bss_start__ = .;
        _sbss = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
        _ebss = .;
    } > IWRAM

    /*
     * dummy section to check free space of IWRAM - .data/.bss/.fast_text
     * must not grow past SYSVEC (0x03006400); U0AREA/UAREA no longer sit
     * past this boundary (moved to EWRAM, see MEMORY block above), so
     * there's slack between here and IWRAM's actual end (0x03008000)
     * now, this bound just protects SYSVEC specifically.
     */
    .stack_check : {
        . = ALIGN(4);
        ASSERT(. < (ORIGIN(IWRAM) + 25K), "Error: IWRAM overflowed into SYSVEC!");
    } > IWRAM
}
