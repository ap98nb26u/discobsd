#
# name	getty					type	status		comments
#
console	"/usr/libexec/getty std.default"	vt100	on secure	#special

# Enable some of these for additional logins.  Do NOT enable the same one as the
# console port, or strange things will happen.  You can turn off the console port
# if you would rather use the getty on the real tty - it's up to you.

tty0	"/usr/libexec/getty std.default"	xterm	off secure
tty1	"/usr/libexec/getty std.default"	xterm	off secure
tty2	"/usr/libexec/getty std.default"	xterm	off secure
tty3	"/usr/libexec/getty std.default"	xterm	off secure
tty4	"/usr/libexec/getty std.default"	xterm	off secure
tty5	"/usr/libexec/getty std.default"	xterm	off secure
ttyUSB0	"/usr/libexec/getty std.default"	xterm	off secure

# gba: pseudo-terminals for telnet logins through slipd (usr.sbin/slipd).
# Nothing runs a getty on them; "secure" lets root log in, as root is the
# only account - the SLIP link is a private cable to one PC.  vt100 is
# what login puts in TERM (telnet clients mostly run in such terminals).
ttyp0	none				vt100	off secure
ttyp1	none				vt100	off secure
