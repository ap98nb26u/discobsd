#!/bin/sh
HOME=/; export HOME
PATH=/sbin:/bin:/usr/sbin:/usr/bin; export PATH
exec >/dev/console 2>&1

if test "$1" != "autoboot"; then
    #
    # Switch from single-user to multi-user mode.
    #
    echo

    # Halt the processor.
    #reboot -l -h
    exit 0
fi

#
# Entering multiuser mode: check filesystems
#
# This will *only* work if fsck can do your root file system
# without a temporary file, and if the root file system is
# checked alone in a pass by itself -- be careful!  This can
# *seriously* mess you up.
#
# On a build whose root is baked into ROM (kern.romroot, see
# KERN_ROMROOT in kern_sysctl.c), the filesystem can never be
# dirty and can never be repaired - skip fsck/umount/mount
# entirely rather than depend on fsck's handling of a device
# that unconditionally refuses every write.
#
# "sysctl -q" (exit status only, see sysctl.c) is used here
# instead of `sysctl -n` in a backtick/pipe, since command
# substitution pulls in far more of this shell (fork+pipe+read)
# than a plain "if command; then" exit-status test.
#
if sysctl -q kern.romroot; then
    echo "Root filesystem is ROM-backed; skipping file system checks."
else
    echo "Automatic boot in progress: starting file system checks."

    fsck -p
    fsckstatus=$?
    case $fsckstatus in
    0)
        # Filesystems are clean
        ;;
    2)
        echo "--- Critical errors detected: run fsck to repair manually"
        exit 1 ;;
    4)
        # Root filesystem modified: NO SYNC!
        echo "--- Errors repaired, rebooting..."
        reboot -n ;;
    8)
        echo "--- Filesystem check failed... help!"
        exit 1 ;;
    12)
        echo "--- Interrupted by user"
        exit 1 ;;
    *)
        # fsck only exits 0/4/8, so any other status is unexpected. In
        # particular a status >= 128 means fsck was KILLED BY A SIGNAL
        # (status - 128), i.e. it crashed rather than exiting - a transient
        # fault (e.g. an SD read error), not an exit-code the case is
        # missing. Print the raw number so the cause is diagnosable.
        echo "--- fsck exited with unexpected status $fsckstatus"
        echo "--- (status >= 128 means fsck was killed by signal status-128)"
        exit 1 ;;
    esac

    #
    # First umount everything in case the system is going back into multiuser
    # mode.  If the system is being booted for the first time nothing is mounted
    # except the root filesystem and umount ignores attempts to unmount /.
    #
    umount -a

    #
    # Now mount everything mentioned in /etc/fstab *except* filesystems with the
    # 'na' (noauto) option.
    #
    mount -a
fi

hostname "discobsd"

rm -f /etc/nologin

# Patch /etc/motd: put the running kernel version on line 1 and keep any
# custom text from the first blank line down - the stock 2.11BSD rc
# behavior. Skipped on a ROM-backed root (kern.romroot): /etc/motd (and
# /tmp) cannot be written there, so the committed placeholder motd stands.
#
# This had been simplified to a plain `sysctl -n kern.version >/etc/motd`
# overwrite because `sed` reportedly hung at process entry on real GBAED
# hardware. That was the same stale-userland/veneer class of exec failure
# since resolved (and the SD userland has been rebuilt many times since),
# so the original sed/cmp/cp logic is restored. If sed ever hangs here
# again, boot stops right after "Updating motd..." - that is the signal.
# NB: no "if ! cmd" here - this port's Bourne sh has no "!" negation
# reserved word (it tries to exec "!": "/etc/rc: !: not found"), so the
# ROM-root case is the empty "then" branch and the real work is in "else".
if sysctl -q kern.romroot; then
    :   # ROM-backed root: /etc/motd (and /tmp) are read-only, skip.
else
    echo -n "Updating motd..."
    if [ ! -f /etc/motd ]; then
        echo "" >/etc/motd && chmod 664 /etc/motd && chown root.wheel /etc/motd
    fi
    T=/tmp/_motd
    sysctl -n kern.version | sed 1q >$T
    sed -n '/^$/,$p' </etc/motd >>$T
    cmp -s $T /etc/motd || cp $T /etc/motd
    rm -f $T
    echo "done"
fi

echo -n "Starting daemons:"
# update (periodic sync) and cron both daemonize and rely on
# setitimer()/SIGALRM. Starting update used to hang boot here: delivering
# a caught signal was broken on this port (sigtramp had never been ported
# to the GBA simulated-SWI syscall ABI, so a handler ran off into garbage
# - the update hang and the sed hang above were the same root cause),
# fixed in commit 447358a. With signal delivery working they are safe to
# start. Skipped on a ROM-backed root (kern.romroot, the plain GBA/mrams
# build): update's periodic sync is pointless on a read-only root, cron
# cannot write its logs, and that build's tiny RAM/swap makes extra
# resident daemons costly.
if sysctl -q kern.romroot; then
    :   # ROM-backed root: skip update/cron (see note above).
else
    update && echo -n " update"
    cron && echo -n " cron"
fi
echo

# Site-specific startup, incl. persistent tunables (writable-root builds).
# On a ROM-backed root (mrams) this is skipped: it is read-only, and settings
# there persist in cart SRAM instead (see sram.c). On the SD-root GBAED build,
# put persistent "sysctl -w ..." lines (e.g. keyboard auto-repeat) in
# /etc/rc.local to have them reapplied every boot. Same "no ! negation" note
# as above, so the ROM-root case is the empty "then" branch.
if sysctl -q kern.romroot; then
    :   # ROM-backed root: skip (SRAM persists settings there).
else
    test -f /etc/rc.local && . /etc/rc.local
fi

date
exit 0
