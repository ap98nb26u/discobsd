#!/bin/sh
HOME=/; export HOME
PATH=/sbin:/bin:/usr/sbin:/usr/bin; export PATH
exec >/dev/console 2>&1

if test "$1" != "autoboot"; then
    #
    # Switch from single-user to multi-user mode.
    #
    echo

    # Halt the processor.
    #reboot -l -h
    exit 0
fi

#
# Entering multiuser mode: check filesystems
#
# This will *only* work if fsck can do your root file system
# without a temporary file, and if the root file system is
# checked alone in a pass by itself -- be careful!  This can
# *seriously* mess you up.
#
# On a build whose root is baked into ROM (kern.romroot, see
# KERN_ROMROOT in kern_sysctl.c), the filesystem can never be
# dirty and can never be repaired - skip fsck/umount/mount
# entirely rather than depend on fsck's handling of a device
# that unconditionally refuses every write.
#
# "sysctl -q" (exit status only, see sysctl.c) is used here
# instead of `sysctl -n` in a backtick/pipe, since command
# substitution pulls in far more of this shell (fork+pipe+read)
# than a plain "if command; then" exit-status test.
#
if sysctl -q kern.romroot; then
    echo "Root filesystem is ROM-backed; skipping file system checks."
else
    echo "Automatic boot in progress: starting file system checks."

    fsck -p
    case $? in
    0)
        # Filesystems are clean
        ;;
    2)
        echo "--- Critical errors detected: run fsck to repair manually"
        exit 1 ;;
    4)
        # Root filesystem modified: NO SYNC!
        echo "--- Errors repaired, rebooting..."
        reboot -n ;;
    8)
        echo "--- Filesystem check failed... help!"
        exit 1 ;;
    12)
        echo "--- Interrupted by user"
        exit 1 ;;
    *)
        echo "--- Unknown error in fsck"
        exit 1 ;;
    esac

    #
    # First umount everything in case the system is going back into multiuser
    # mode.  If the system is being booted for the first time nothing is mounted
    # except the root filesystem and umount ignores attempts to unmount /.
    #
    umount -a

    #
    # Now mount everything mentioned in /etc/fstab *except* filesystems with the
    # 'na' (noauto) option.
    #
    mount -a
fi

hostname "discobsd"

rm -f /etc/nologin

# Patch /etc/motd.
#
# The original version of this piped `sysctl -n kern.version` through
# `sed 1q`, extracted everything from the first blank line onward in
# the old motd via a second sed, and only replaced motd if `cmp` said
# it actually changed - preserving any custom text an admin appended
# below the version banner. That needed sed, cmp, cp and a pipe, none
# of which are worth depending on here: sed hung on real GBAED
# hardware (reproducibly, at process entry, before any syscall -
# never reproduced under mGBA) for reasons not yet understood, and
# this whole step is cosmetic. Just overwrite motd outright.
echo -n "Updating motd..."
sysctl -n kern.version >/etc/motd
chmod 664 /etc/motd
chown root.wheel /etc/motd
echo "done"

echo -n "Starting daemons:"
# update/cron temporarily disabled - update.c is the first program in this
# port's boot sequence to use setitimer()/sigsuspend() (a 30s SIGALRM
# repeat, waited on via sigsuspend()), and boot hangs here on both mGBA
# and real GBAED hardware (real hardware hangs slightly earlier than
# mGBA, right after update's own execve returns - same kind of platform
# timing difference seen with sed hanging on real hardware only, ../etc/rc
# sed changes, this session). Kernel-side, schedcpu()'s once-a-second
# p_realtimer decrement + psignal(SIGALRM) (kern_synch.c) and daemon()'s
# fork()+_exit(0) (lib/libc/gen/daemon.c) both look correct on inspection,
# but this is the *first* real-world exercise of that path on this port -
# not yet proven correct end to end. Not essential for reaching a login
# prompt, so skipped for now rather than blocking on it - re-enable once
# the itimer/SIGALRM/sigsuspend chain has been debugged.
#update && echo -n "update"
#cron && echo -n "cron"
echo

#/etc/rc.local

date
exit 0
